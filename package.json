{
  "name": "chapter-wise-splitter",
  "version": "1.0.0",
  "description": "Split EPUB / TXT / HTML / Markdown novels into files of N chapters \u2013 fully in the browser.",
  "private": true,
  "scripts": {
    "start": "python3 -m http.server 8080 --bind 0.0.0.0",
    "build:css": "tailwindcss -i src/input.css -o css/style.css --minify",
    "watch:css": "tailwindcss -i src/input.css -o css/style.css --watch",
    "fixtures": "node tests/make-fixtures.js",
    "test": "python3 tests/e2e.py",
    "fixtures:big": "node tests/make-big-fixtures.js",
    "test:stress": "python3 tests/stress.py"
  },
  "devDependencies": {
    "jszip": "^3.10.1",
    "tailwindcss": "^3.4.17"
  },
  "license": "MIT"
}
